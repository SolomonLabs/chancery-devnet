###############################################################################
# Canonical text representation
###############################################################################
* text=auto eol=lf

*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.mts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.bat text eol=lf
*.ps1 text eol=lf
*.dockerfile text eol=lf
Dockerfile text eol=lf
*.env text eol=lf
*.log text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.conf text eol=lf
*.config text eol=lf
*.ini text eol=lf
*.toml text eol=lf

.editorconfig text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.prettierrc text eol=lf
.prettierrc.json text eol=lf
tsconfig.json text eol=lf
package.json text eol=lf
package-lock.json text eol=lf

###############################################################################
# Evidence and vendored files whose exact upstream bytes are checksum-bound.
# These overrides must appear after the generic text rules.
###############################################################################
vendor/combined/index.d.ts -text

###############################################################################
